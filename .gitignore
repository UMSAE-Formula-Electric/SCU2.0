# Object files
*.o
*.ko
*.obj
*.elf

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Include makefiles
!Makefile
*~

# Eclipse / STM32CubeIDE managed-build output.
# Anchored with a leading slash: the old unanchored "Debug" pattern matched a
# directory named Debug at ANY depth, so it silently swallowed build/Debug
# while leaving build/Release, build/Gcc12 etc. tracked.
/Debug/
/Release/

# CMake build output. CMakePresets.json uses build/<presetName>/, so this must
# cover the whole tree rather than one preset name.
/build/
cmake-build-*

*.launch

.idea
.settings

